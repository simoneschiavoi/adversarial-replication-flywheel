# --- environments / caches
.venv/
.venv-old-312/
__pycache__/
*.pyc

# --- secrets (never public; .env.example IS shipped)
.env
.env.*
!.env.example

# --- deterministic suite: regenerated by src/freeze_suite.py (hardcoded seeds,
#     MANIFEST sha-pinned in the ledger). suite/holdout is chmod-000 by design
#     and must stay unreadable — circuit/truth artifacts stay out of git;
#     MANIFEST.json (paths + sha pins only, no data) ships as the audit pin
#     (root suite + the test-campaign copy the audit notebooks read).
suite/*
!suite/MANIFEST.json
notebooks/data/test-campaign/suite/*
!notebooks/data/test-campaign/suite/MANIFEST.json

# --- per-job raw payloads (GB-scale). The reviewable evidence ships as
#     runs/report/ (report.md, summary/rounds/claims.json, jobs_export.csv with
#     every job ID) plus the ledger; raw per-job run directories stay local.
runs/*
!runs/report
!runs/g4sup*.sh

# --- EXP-008 raw payloads (4.2 GB under data/); SPEC, PREREGISTRATION and
#     ANALYSIS are the prereg evidence and DO ship
experiments/EXP-008-GATE-CALIBRATION/data/
